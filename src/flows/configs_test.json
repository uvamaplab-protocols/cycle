{
    "elements": [
        {
            "type": "Text",
            "text": "Please choose the protocol population"
        },
        {
            "type": "Buttons",
            "buttons": [
                "HC::Hormonal contraception (pill, shot, or ring)",
                "NM::Naturally menstruating"
            ],
            "variable_name": "global:population",
            "output_name": "config_population"
        },
        {
            "type": "Text",
            "text": "What time would you like to receive your daily check-ins?"
        },
        {
            "type": "Time",
            "default_time": "20:00",
            "variable_name": "global:checkin_time",
            "output_name": "config_checkin_time"
        },
        {
            "type": "Text",
            "text": "Testing only: pick the ovulation test days. In the study these come from the invitation."
        },
        {
            "type": "Scheduler",
            "variable_name": "global:opk_days",
            "output_name": "config_opk_days",
            "count": 4,
            "days_behind": 0,
            "days_ahead": 90,
            "has_time": false,
            "schedule_flow": false
        }
    ],
    "navigation_conditions": [
        "wait_for_complete",
        "wait_for_click"
    ]
}
